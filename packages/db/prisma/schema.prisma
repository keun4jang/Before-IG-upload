// Before IG Upload — Prisma schema
// DEMO_MODE=1 에서는 사용되지 않습니다. 프로덕션(DEMO_MODE=0)에서 PostgreSQL 사용.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String?    @unique
  name      String?
  image     String?
  createdAt DateTime   @default(now())
  projects  Project[]
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String?
  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  description String        @default("")
  notes       String        @default("")
  status      String        @default("draft") // draft | analyzing | analyzed | archived
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assets       Asset[]
  slides       Slide[]
  captionDraft CaptionDraft?
  runs         AnalysisRun[]

  @@index([ownerId])
}

model Asset {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  storageKey String
  previewUrl String?
  width      Int?
  height     Int?
  sizeBytes  Int?
  sortOrder  Int     @default(0)
  slide      Slide?

  @@index([projectId])
}

model Slide {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId       String  @unique
  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  slideNumber   Int
  ocrRawText    String  @default("")
  ocrEditedText String?
  ocrConfidence Float?
  textBlocksJson Json?

  @@unique([projectId, slideNumber])
  @@index([projectId])
}

model CaptionDraft {
  id           String  @id @default(cuid())
  projectId    String  @unique
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalText String  @default("")
  editedText   String?
}

model AnalysisRun {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String   @default("queued") // queued | running | succeeded | failed
  startedAt    DateTime?
  finishedAt   DateTime?
  overallScore Int?
  error        String?
  summaryJson  Json?
  resultJson   Json?
  createdAt    DateTime @default(now())
  issues       Issue[]

  @@index([projectId])
}

model Issue {
  id            String   @id @default(cuid())
  analysisRunId String
  run           AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  scopeType     String   // slide | caption | project
  scopeRefId    String
  category      String   // spelling | spacing | grammar | style | punctuation | consistency | duplication | fact | risk
  severity      String   // high | medium | low
  confidence    Float    @default(0.5)
  sourceText    String
  suggestedText String?
  explanation   String
  locationJson  Json?
  isResolved    Boolean  @default(false)
  claimCheck    ClaimCheck?

  @@index([analysisRunId])
}

model ClaimCheck {
  id         String   @id @default(cuid())
  issueId    String   @unique
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  claimText  String
  domain     String
  highRisk   Boolean  @default(false)
  verdict    String
  rationale  String
  confidence Float    @default(0.3)
  checkedAt  DateTime @default(now())
  sources    EvidenceSource[]
}

model EvidenceSource {
  id           String     @id @default(cuid())
  claimCheckId String
  claimCheck   ClaimCheck @relation(fields: [claimCheckId], references: [id], onDelete: Cascade)
  title        String
  url          String
  snippet      String     @default("")
  sourceType   String?

  @@index([claimCheckId])
}

model Setting {
  key   String @id
  value String
}
