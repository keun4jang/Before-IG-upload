# =============================================================================
# Before IG Upload — 환경변수 예시
# -----------------------------------------------------------------------------
# 이 파일을 복사해서 `.env` 로 저장하세요:  cp .env.example .env
#
# ⭐️ 아무 값도 채우지 않아도 DEMO_MODE=1 로 즉시 실행됩니다.
#    (DB / Redis / OCR / LLM / Search 없이도 데모 플로우가 동작합니다.)
#    실제 서비스로 올릴 때 아래 항목을 하나씩 채워 넣으면 됩니다.
# =============================================================================

# -----------------------------------------------------------------------------
# 실행 모드
# -----------------------------------------------------------------------------
# DEMO_MODE=1  → DB 없이 in-memory 저장소 + 로컬 분석 엔진 + 더미 provider 사용.
#                외부 API 키가 하나도 없어도 전체 플로우가 돌아갑니다.
# DEMO_MODE=0  → PostgreSQL(Prisma) + (선택)Redis/BullMQ + 실제 provider 사용.
DEMO_MODE=1

# 앱이 자기 자신을 부를 때 쓰는 base URL (server actions/route handlers 절대경로용)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 데이터베이스 (DEMO_MODE=0 일 때 필수)
# -----------------------------------------------------------------------------
# docker-compose 사용 시 기본값:
DATABASE_URL="postgresql://big:big@localhost:5432/big?schema=public"

# -----------------------------------------------------------------------------
# 작업 큐 (선택) — 비동기 분석용. 없으면 web에서 동기(sync) 분석으로 graceful fallback.
# -----------------------------------------------------------------------------
# REDIS_URL="redis://localhost:6379"
# ANALYSIS_MODE=auto   # auto | sync | queue  (auto: Redis 있으면 queue, 없으면 sync)
ANALYSIS_MODE=auto

# -----------------------------------------------------------------------------
# 파일 저장소 provider (StorageProvider adapter)
# -----------------------------------------------------------------------------
# STORAGE_DRIVER=local  → 로컬 디스크(.storage/)에 저장. 키 불필요.
# STORAGE_DRIVER=s3     → S3 호환 스토리지. 아래 값 필요.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# S3 (STORAGE_DRIVER=s3 일 때)
# S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
# S3_REGION=ap-northeast-2
# S3_BUCKET=before-ig-upload
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # MinIO 등은 true

# -----------------------------------------------------------------------------
# OCR provider (OcrProvider adapter) — graceful degradation
# -----------------------------------------------------------------------------
# OCR_PROVIDER=dummy      → 데모용. 이미지에서 샘플 텍스트를 반환(키 불필요).
# OCR_PROVIDER=tesseract  → 로컬/오픈소스 OCR (tesseract.js). 키 불필요, 느릴 수 있음.
# OCR_PROVIDER=google     → Google Cloud Vision. 아래 키 필요.
OCR_PROVIDER=dummy
# GOOGLE_VISION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# LLM provider (LlmProvider adapter) — 사실 검토 요약 + 이미지 비전 추출(선택)
# -----------------------------------------------------------------------------
# LLM_PROVIDER=none      → LLM 없이 로컬 규칙 기반 검토만 수행(근거 부족/검토 필요로 보수적 처리).
#                          이미지 텍스트 추출도 로컬 OCR(Tesseract)로 자동 대체됨.
# LLM_PROVIDER=gemini    → Google Gemini(무료 티어 제공). 이미지 텍스트+국기까지 인식. GEMINI_API_KEY 필요.
# LLM_PROVIDER=openai    → OpenAI 호환(vision 지원 모델 필요). OPENAI_API_KEY 필요.
# LLM_PROVIDER=anthropic → Anthropic(vision 지원 모델). ANTHROPIC_API_KEY 필요.
#   설정 시 이미지를 직접 이해해서(장식 요소 제외) 텍스트를 정리하고, 국기 나라까지 읽어
#   지역↔국기 검수를 해줍니다(로컬 OCR보다 정확). 없어도 로컬 OCR로 계속 동작합니다.
LLM_PROVIDER=none
# Gemini 무료 키: https://aistudio.google.com/apikey 에서 "Create API key" (무료 티어)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Search provider (SearchProvider adapter) — 근거 자료 수집(선택)
# -----------------------------------------------------------------------------
# SEARCH_PROVIDER=none   → 웹 검색 없이 "근거 부족/출처 확인 권장"으로 안내.
# SEARCH_PROVIDER=tavily → Tavily 검색. TAVILY_API_KEY 필요.
# SEARCH_PROVIDER=serpapi→ SerpAPI. SERPAPI_API_KEY 필요.
SEARCH_PROVIDER=none
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# -----------------------------------------------------------------------------
# 구글시트 연동(SMCC 검수, 선택) — 신청 시트의 "모든 탭"을 자동으로 찾아서 합친다
# -----------------------------------------------------------------------------
# 비워두면 시트 URL에 적힌 gid(탭 하나)만 읽는다.
# 설정하면 Google Sheets API로 같은 스프레드시트 안의 다른 탭(예: 지난 신청 아카이브 탭)까지
# 전부 찾아서 헤더가 같은 탭끼리 데이터를 합쳐 검수 대상에 포함한다.
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → API 키 생성 →
# "Google Sheets API"만 허용하도록 제한(읽기 전용) 하면 안전하게 쓸 수 있다.
# GOOGLE_SHEETS_API_KEY=

# -----------------------------------------------------------------------------
# 인증 (선택) — Auth.js. 없으면 익명/로컬 프로젝트 모드로 동작.
# -----------------------------------------------------------------------------
AUTH_ENABLED=false
# AUTH_SECRET=            # openssl rand -base64 32
# GITHUB_ID=
# GITHUB_SECRET=
